rules_version = '2';

// All OTP service collections are backend-only. The Admin SDK bypasses these
// rules; every direct client read or write is denied, including for
// authenticated Firebase users. Clients interact only through the callable
// API and Firebase Auth.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
