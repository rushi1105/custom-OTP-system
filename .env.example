# ---------------------------------------------------------------------------
# OTP Infrastructure Service - example local environment file.
#
# Copy this file to `functions/.env.local` for LOCAL development (git-ignored;
# firebase-tools loads it automatically for the Functions emulator).
#
# RULES:
#  - Never commit a real `.env` file (it is git-ignored).
#  - Never put production credentials or production project IDs here.
#  - Values below are non-secret local placeholders and safe to commit.
# ---------------------------------------------------------------------------

# Effective runtime environment: local | test | staging | production.
# Policy (docs/DECISIONS.md D-025):
#  - Unset + Firebase emulator  -> local (inferred)
#  - Unset + deployed runtime   -> startup fails closed
#  - Set to staging/production  -> DELIVERY_PROVIDER must be explicit and never mock
OTP_ENVIRONMENT=local

# Firebase project used by the emulator suite.
# The `demo-` prefix makes the Firebase CLI run fully offline and prevents
# accidental access to any real project.
FIREBASE_PROJECT_ID=demo-otp-infrastructure-service

# Deployment region for Cloud Functions (proposed, see docs/DECISIONS.md).
FUNCTIONS_REGION=asia-south1

# Delivery provider selected by the backend.
#  - local: defaults to mock when unset; explicit values must be known providers.
#  - test: must be set explicitly; mock is permitted for approved tests.
#  - staging/production: must be set explicitly; mock is rejected.
DELIVERY_PROVIDER=mock

# HMAC pepper for OTP codes, phone hashes, and requester hashes.
# MUST be at least 32 characters. This placeholder is for LOCAL use only.
# Deployed functions bind OTP_HASH_PEPPER through Secret Manager
# (`defineSecret`); do not set the real value as a plaintext deployment env.
# Staging/production MUST provide a real random pepper from secret management
# (D-020); never store real values in any committed file.
OTP_HASH_PEPPER=local-dev-placeholder-not-a-real-secret-0123456789abcdef
# Positive integer with no leading zeros; increment when rotating the pepper.
# Live challenges created under a previous version become unverifiable
# (detected and audited, never silently accepted).
OTP_HASH_PEPPER_VERSION=1
