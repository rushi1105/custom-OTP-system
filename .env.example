# ---------------------------------------------------------------------------
# OTP Infrastructure Service - example local environment file.
#
# Copy this file to `.env` for LOCAL development only.
#
# RULES:
#  - Never commit a real `.env` file (it is git-ignored).
#  - Never put production credentials or production project IDs here.
#  - Values below are non-secret local placeholders and safe to commit.
# ---------------------------------------------------------------------------

# Firebase project used by the emulator suite.
# The `demo-` prefix makes the Firebase CLI run fully offline and prevents
# accidental access to any real project.
FIREBASE_PROJECT_ID=demo-otp-infrastructure-service

# Deployment region for Cloud Functions (proposed, see docs/DECISIONS.md).
FUNCTIONS_REGION=asia-south1

# Delivery provider selected by the backend.
# Phase 2 supports ONLY the mock provider; any other value fails fast.
DELIVERY_PROVIDER=mock

# HMAC pepper for OTP codes, phone hashes, and requester hashes (Phase 2).
# MUST be at least 32 characters. This placeholder is for LOCAL use only.
# Staging/production MUST provide a real random pepper from secret management
# (D-020); never store real values in any committed file.
OTP_HASH_PEPPER=local-dev-placeholder-not-a-real-secret-0123456789abcdef
# Increment when rotating the pepper; live challenges created under a previous
# version become unverifiable (detected and audited, never silently accepted).
OTP_HASH_PEPPER_VERSION=1

# To run the Functions emulator locally, copy this file to functions/.env.local
# (git-ignored): firebase-tools loads it automatically.
